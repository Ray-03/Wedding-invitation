# Site URL for invite links in Excel (import/export scripts)
# Local:  http://localhost:3000
# Live:   https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Dynamic Wedding Configuration (Next.js public client-side)
NEXT_PUBLIC_GROOM_NAME="John Doe"
NEXT_PUBLIC_BRIDE_NAME="Jane Doe"
# Shorter names for livestream invitations (cover / chrome)
NEXT_PUBLIC_GROOM_NAME_LIVESTREAM="John Doe"
NEXT_PUBLIC_BRIDE_NAME_LIVESTREAM="Jane Doe"
NEXT_PUBLIC_WEDDING_DATE="15082026"
NEXT_PUBLIC_WEDDING_TIME="09:00"
# Last day RSVP can be submitted (inclusive). Format: ddmmyyyy or YYYY-MM-DD. Empty = always open.
NEXT_PUBLIC_RSVP_CLOSE_DATE="10082026"
NEXT_PUBLIC_VENUE_NAME="Reception Venue"
NEXT_PUBLIC_VENUE_ADDRESS="Venue street address"
NEXT_PUBLIC_VENUE_MAPS_URL="https://maps.google.com/?q=Reception+Venue"
NEXT_PUBLIC_HOLY_MATRIMONY_VENUE="Church Name"
NEXT_PUBLIC_HOLY_MATRIMONY_ADDRESS="Church street address"
NEXT_PUBLIC_HOLY_MATRIMONY_MAPS_URL="https://maps.google.com/?q=Church"
NEXT_PUBLIC_VOW_URL="https://www.youtube.com/watch?v=fRUJjOViokk"
NEXT_PUBLIC_HOLY_MATRIMONY_TIME="10:00"
NEXT_PUBLIC_BIBLE_QUOTE="Yours is the light by which my spirit's born: you are my sun, my moon, and all my stars"
NEXT_PUBLIC_BIBLE_VERSE="E.E. Cummings"
NEXT_PUBLIC_STORY_QUOTE="Our love story begins with a small encounter."
NEXT_PUBLIC_STORY_QUOTE_SOURCE="The Couple"

# Parent Names
NEXT_PUBLIC_GROOM_FATHER_NAME=""
NEXT_PUBLIC_GROOM_MOTHER_NAME=""
NEXT_PUBLIC_BRIDE_FATHER_NAME=""
NEXT_PUBLIC_BRIDE_MOTHER_NAME=""

# Optional parking note shown under reception details
# NEXT_PUBLIC_PARKING_NOTE="Please use the building parking garage."

# Optional gift transfer accounts (omit to hide the gifts section)
# NEXT_PUBLIC_GROOM_BANK_NAME="Bank Name"
# NEXT_PUBLIC_GROOM_BANK_ACCOUNT=""
# NEXT_PUBLIC_GROOM_BANK_HOLDER=""
# NEXT_PUBLIC_BRIDE_BANK_NAME="Bank Name"
# NEXT_PUBLIC_BRIDE_BANK_ACCOUNT=""
# NEXT_PUBLIC_BRIDE_BANK_HOLDER=""

# Firebase web config (safe in browser; data is protected by API + HMAC + Firestore rules)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_FIRESTORE_DATABASE_ID=(default)

# Server-only HMAC secret for personal invite links (?g=&k=). Required.
# Generate: openssl rand -hex 32
INVITE_HMAC_SECRET=

# Optional: reCAPTCHA v3 site key for Firebase App Check (blocks Postman/scripts)
# NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=
# Set true in production after App Check is registered in Firebase Console
# APP_CHECK_ENFORCE=true
# Local App Check debug token from Firebase Console (optional)
# NEXT_PUBLIC_APPCHECK_DEBUG_TOKEN=

# Local path to Admin SDK JSON for: npm run guests  AND  Next.js API routes
# Download from Firebase Console → Project settings → Service accounts
# Never commit this file.
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json
# On Vercel, paste the JSON instead:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# Optional overrides for WhatsApp invite Chat WA column (npm run guests)
# INVITE_MESSAGE_PHYSICAL_VENUE=Holy Matrimony Venue
# INVITE_MESSAGE_LIVESTREAM_VENUE=Reception Venue
